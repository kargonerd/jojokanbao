---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "JOJO",
  description = "关注现实问题、技术变迁与社会关系。",
} = Astro.props;

const pageTitle = title === "JOJO" ? title : `${title} · JOJO`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/brand/jojo-kanbao-mark.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="JOJO" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initializeBrowserAnalytics, browserAnalyticsEnabled, setBrowserAnalyticsEnabled } from "@jojo/analytics/browser";
      void initializeBrowserAnalytics({
        token: import.meta.env.PUBLIC_POSTHOG_TOKEN,
        host: import.meta.env.PUBLIC_POSTHOG_HOST,
        production: import.meta.env.PROD && import.meta.env.PUBLIC_RELEASE_CHANNEL !== "preview",
        context: { client: "homepage", platform: "web", app_version: import.meta.env.PUBLIC_APP_VERSION || "homepage", release_channel: "stable", app_variant: "standard" },
      });
      const preference = document.querySelector<HTMLInputElement>("#analytics-preference");
      if (preference) {
        preference.checked = browserAnalyticsEnabled();
        preference.addEventListener("change", () => setBrowserAnalyticsEnabled(preference.checked));
      }
    </script>
  </body>
</html>
