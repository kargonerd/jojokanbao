{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jojo-press.local/schema/book.schema.json",
  "title": "Book",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "title",
    "language",
    "source",
    "content_list",
    "layout"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uri",
        "page_count"
      ],
      "properties": {
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "content_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "text",
          "page",
          "proofread_status",
          "source_page",
          "source_ocr_text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "paragraph",
              "footnote",
              "image",
              "table",
              "page_number",
              "toc"
            ]
          },
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "proofread_status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "approved"
            ]
          },
          "source_page": {
            "type": "integer",
            "minimum": 1
          },
          "source_ocr_text": {
            "type": "string"
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "blocks"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "kind",
                "bbox"
              ],
              "properties": {
                "content_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "image",
                    "table"
                  ]
                },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
