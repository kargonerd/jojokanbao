{
  "name": "@jojo/desktop",
  "version": "0.0.1",
  "description": "JOJO看报的阅读与问答桌面客户端",
  "author": {
    "name": "JOJO Platform Contributors",
    "email": "kargonerd@users.noreply.github.com"
  },
  "homepage": "https://jojokanbao.cn",
  "desktopName": "jojo-kanbao.desktop",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:electron": "pnpm build && playwright test e2e/electron.spec.ts",
    "typecheck": "tsc --noEmit",
    "dev:electron": "node ./scripts/dev-runner.js",
    "start": "pnpm build && electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "@jojo/auth": "workspace:*",
    "@jojo/content": "workspace:*",
    "@jojo/pdf-viewer": "workspace:*",
    "@jojo/tsconfig": "workspace:*",
    "@jojo/ui": "workspace:*",
    "@jojo/web": "workspace:*",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.0",
    "electron": "^35.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.0.0",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "cn.jojokanbao.desktop",
    "productName": "JOJO看报",
    "executableName": "jojo-kanbao",
    "artifactName": "JOJO-Kanbao-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "../web/public/brand/jojo-kanbao-mark.svg"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.news",
      "icon": "../web/public/brand/jojo-kanbao-mark.svg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "../web/public/brand/jojo-kanbao-mark.svg",
      "syncDesktopName": true,
      "synopsis": "JOJO看报桌面阅读客户端"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "JOJO看报"
    }
  }
}
