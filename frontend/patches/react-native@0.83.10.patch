 def override_hermes_dir_envvar_defined()
@@ -303,9 +305,10 @@ end
 # - version: the version of React Native
 # - build_type: debug or release
 def hermes_artifact_exists(tarball_url)
+    return false if tarball_url.to_s.empty?
     # -L is used to follow redirects, useful for the nightlies
     # I also needed to wrap the url in quotes to avoid escaping & and ?.
-    return (`curl -o /dev/null --silent -Iw '%{http_code}' -L "#{tarball_url}"` == "200")
+    return (`curl --fail --retry 2 --retry-all-errors --retry-delay 1 --connect-timeout 10 --max-time 30 -o /dev/null --silent -Iw '%{http_code}' -L "#{tarball_url}"` == "200")
 end
 
