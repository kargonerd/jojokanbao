diff --git a/sdks/hermes-engine/hermes-utils.rb b/sdks/hermes-engine/hermes-utils.rb
index 4f5f3e8d3ba8eed22dea0f9936c6933df67bcdc6..9e2035460f3798d4aeac0e3f42cb195820158beb 100644
--- a/sdks/hermes-engine/hermes-utils.rb
+++ b/sdks/hermes-engine/hermes-utils.rb
@@ -70,7 +70,9 @@ def hermes_source_type(version, react_native_path)
         return HermesEngineSourceType::DOWNLOAD_PREBUILT_NIGHTLY_TARBALL
     end
 
-    return HermesEngineSourceType::BUILD_FROM_GITHUB_MAIN
+    # A transient Maven outage must not select an unrelated development VM.
+    return HermesEngineSourceType::BUILD_FROM_GITHUB_TAG if File.exist?(hermestag_file(react_native_path))
