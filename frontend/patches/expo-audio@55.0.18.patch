@@ -0,0 +1,128 @@
+package expo.modules.audio.service
+
+import android.net.Uri
+import androidx.media3.common.C
+import androidx.media3.common.ForwardingSimpleBasePlayer
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MediaMetadata
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import com.google.common.util.concurrent.Futures
+import com.google.common.util.concurrent.ListenableFuture
+import expo.modules.audio.LockScreenPlaybackState
+import expo.modules.audio.Metadata
+
+/** A chapter-sized system view of the same player used for individual TTS parts. */
+@UnstableApi
+internal class LockScreenAudioPlayer(
+  player: Player,
+  private val request: (String, String, Double?) -> Unit
+) : ForwardingSimpleBasePlayer(player) {
+  private var chapter: LockScreenPlaybackState? = null
+  private var metadata: MediaMetadata = MediaMetadata.EMPTY
+
+  val hasChapter: Boolean get() = chapter != null
+
+  fun updatePlayback(value: LockScreenPlaybackState?) {
+    chapter = value?.takeIf {
+      it.chapterId.isNotBlank() && it.duration.isFinite() && it.position.isFinite() && it.duration >= 0
+    }
+    invalidateState()
+  }
+
+  fun updateMetadata(value: Metadata?, artwork: ByteArray? = null) {
+    metadata = MediaMetadata.Builder()
+      .setTitle(value?.title)
+      .setArtist(value?.artist)
+      .setAlbumTitle(value?.albumTitle)
+      .setArtworkUri(value?.artworkUrl?.let { Uri.parse(it.toString()) })
+      .setArtworkData(artwork, MediaMetadata.PICTURE_TYPE_FRONT_COVER)
+      .build()
+    invalidateState()
+  }
+
+  override fun getState(): State {
+    val original = super.getState()
+    val value = chapter ?: return original
+    val durationMs = (value.duration.coerceIn(0.0, 86_400_000.0) * 1000).toLong()
+    val positionMs = (value.position.coerceIn(0.0, durationMs / 1000.0) * 1000).toLong()
+    val commands = original.availableCommands.buildUpon()
+      .add(Player.COMMAND_PLAY_PAUSE)
+      .add(Player.COMMAND_GET_CURRENT_MEDIA_ITEM)
+      .add(Player.COMMAND_GET_TIMELINE)
+      .add(Player.COMMAND_GET_METADATA)
+      .add(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+      .remove(Player.COMMAND_SET_MEDIA_ITEM)
+      .remove(Player.COMMAND_CHANGE_MEDIA_ITEMS)
+      .remove(Player.COMMAND_SEEK_BACK)
+      .remove(Player.COMMAND_SEEK_FORWARD)
+      .remove(Player.COMMAND_SEEK_TO_PREVIOUS)
+      .remove(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+      .remove(Player.COMMAND_SEEK_TO_NEXT)
+      .remove(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    // Adjacent placeholders let Media3's standard next/previous commands reach handleSeek.
+    // They are never loaded into ExoPlayer; the app resolves the actual chapter.
+    val playlist = mutableListOf<MediaItemData>()
+    if (value.canGoPrevious) {
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS).add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+      playlist.add(MediaItemData.Builder("${value.chapterId}:previous").build())
+    }
+    val currentIndex = playlist.size
+    playlist.add(
+      MediaItemData.Builder(value.chapterId)
+        .setMediaItem(MediaItem.Builder().setMediaId(value.chapterId).setMediaMetadata(metadata).build())
+        .setMediaMetadata(metadata)
+        .setDurationUs(durationMs * 1000)
+        .setIsSeekable(durationMs > 0)
+        .build()
+    )
+    if (value.canGoNext) {
+      commands.add(Player.COMMAND_SEEK_TO_NEXT).add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+      playlist.add(MediaItemData.Builder("${value.chapterId}:next").build())
+    }
+    val waiting = value.buffering || (value.playing && player.playbackState != Player.STATE_READY)
+    return original.buildUpon()
+      .setAvailableCommands(commands.build())
+      .setPlaylist(playlist)
+      .setCurrentMediaItemIndex(currentIndex)
+      .setCurrentAd(C.INDEX_UNSET, C.INDEX_UNSET)
+      .clearPositionDiscontinuity()
+      .setContentPositionMs(positionMs)
+      .setContentBufferedPositionMs(positionMs)
+      .setTotalBufferedDurationMs(0)
+      .setPlaybackState(if (waiting) Player.STATE_BUFFERING else Player.STATE_READY)
+      .setIsLoading(waiting)
+      .setPlayWhenReady(value.playing || value.buffering, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+      // Previous always means previous chapter, even after listening for several minutes.
+      .setMaxSeekToPreviousPositionMs(Long.MAX_VALUE)
+      .setRepeatMode(Player.REPEAT_MODE_OFF)
+      .setShuffleModeEnabled(false)
+      .build()
+  }
+
+  override fun handleSetPlayWhenReady(playWhenReady: Boolean): ListenableFuture<*> {
+    val value = chapter ?: return super.handleSetPlayWhenReady(playWhenReady)
+    // Pause the audio immediately, while JS also records the requested state. Starting again
+    // belongs to JS because the current native part may have ended or need regenerating.
+    if (!playWhenReady) player.pause()
+    request(value.chapterId, if (playWhenReady) "play" else "pause", null)
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handleStop(): ListenableFuture<*> {
+    if (chapter == null) return super.handleStop()
+    return handleSetPlayWhenReady(false)
+  }
+
+  override fun handleSeek(mediaItemIndex: Int, positionMs: Long, seekCommand: Int): ListenableFuture<*> {
+    val value = chapter ?: return super.handleSeek(mediaItemIndex, positionMs, seekCommand)
+    when (seekCommand) {
+      Player.COMMAND_SEEK_TO_PREVIOUS, Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM ->
+        if (value.canGoPrevious) request(value.chapterId, "previous", null)
+      Player.COMMAND_SEEK_TO_NEXT, Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM ->
+        if (value.canGoNext) request(value.chapterId, "next", null)
+      else -> request(value.chapterId, "seek", (positionMs.coerceAtLeast(0) / 1000.0).coerceAtMost(value.duration))
+    }
+    return Futures.immediateVoidFuture()
+  }
+}
