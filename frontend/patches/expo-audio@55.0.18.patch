@@ -0,0 +1,143 @@
+package expo.modules.audio.service
+
+import android.os.Looper
+import androidx.media3.common.MediaItem
+import androidx.media3.common.Player
+import androidx.media3.common.SimpleBasePlayer
+import androidx.media3.common.util.UnstableApi
+import com.google.common.util.concurrent.Futures
+import com.google.common.util.concurrent.ListenableFuture
+import expo.modules.audio.LockScreenPlaybackState
+import expo.modules.audio.Metadata
+import java.net.URL
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@UnstableApi
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], manifest = Config.NONE)
+class LockScreenAudioPlayerTest {
+  private class PartPlayer : SimpleBasePlayer(Looper.getMainLooper()) {
+    var seekCalls = 0
+    var playingRequested = true
+    var part = 0
+    override fun getState(): State = State.Builder()
+      .setAvailableCommands(Player.Commands.Builder().addAll(
+        Player.COMMAND_PLAY_PAUSE, Player.COMMAND_GET_CURRENT_MEDIA_ITEM,
+        Player.COMMAND_GET_TIMELINE, Player.COMMAND_GET_METADATA,
+        Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM, Player.COMMAND_RELEASE
+      ).build())
+      .setPlaylist(listOf(MediaItemData.Builder("part-$part")
+        .setMediaItem(MediaItem.Builder().setMediaId("part-$part").build())
+        .setIsSeekable(true).setDurationUs(if (part == 0) 89_000_000 else 61_000_000).build()))
+      .setCurrentMediaItemIndex(0)
+      .setContentPositionMs(0)
+      .setPlaybackState(Player.STATE_READY)
+      .setPlayWhenReady(playingRequested, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+      .build()
+    fun replacePart() { part += 1; invalidateState() }
+    override fun handleSetPlayWhenReady(value: Boolean): ListenableFuture<*> {
+      playingRequested = value
+      return Futures.immediateVoidFuture()
+    }
+    override fun handleSeek(index: Int, position: Long, command: Int): ListenableFuture<*> {
+      seekCalls += 1
+      return Futures.immediateVoidFuture()
+    }
+    override fun handleRelease(): ListenableFuture<*> = Futures.immediateVoidFuture()
+  }
+
+  private fun chapter(
+    id: String = "chapter-2", previous: Boolean = true, next: Boolean = true,
+    playing: Boolean = false, buffering: Boolean = false
+  ) = LockScreenPlaybackState(id, 1260.0, 360.0, previous, next, playing, buffering)
+
+  @Test fun `system timeline stays chapter sized when the 89 second source is replaced`() {
+    val part = PartPlayer()
+    val system = LockScreenAudioPlayer(part) { _, _, _ -> }
+    system.updatePlayback(chapter())
+    assertEquals(1_260_000L, system.duration)
+    assertEquals(360_000L, system.currentPosition)
+    assertEquals(89_000L, part.duration)
+    part.replacePart()
+    assertEquals(61_000L, part.duration)
+    assertEquals(1_260_000L, system.duration)
+    assertEquals(360_000L, system.currentPosition)
+    assertEquals("chapter-2", system.currentMediaItem?.mediaId)
+    system.release()
+  }
+
+  @Test fun `real chapter commands and absolute seek are delivered to JS without seeking a part`() {
+    val requests = mutableListOf<Triple<String, String, Double?>>()
+    val part = PartPlayer()
+    val system = LockScreenAudioPlayer(part) { id, action, position -> requests.add(Triple(id, action, position)) }
+    system.updatePlayback(chapter())
+    system.seekToNextMediaItem()
+    system.seekToPrevious() // after six minutes this must still mean previous chapter
+    system.seekTo(900_000)
+    system.seekTo(9_000_000)
+    assertEquals(listOf(
+      Triple("chapter-2", "next", null), Triple("chapter-2", "previous", null),
+      Triple("chapter-2", "seek", 900.0), Triple("chapter-2", "seek", 1260.0)
+    ), requests)
+    assertEquals(0, part.seekCalls)
+    system.updatePlayback(chapter(id = "chapter-3", previous = false, next = false))
+    assertFalse(system.isCommandAvailable(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM))
+    assertFalse(system.isCommandAvailable(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM))
+    system.seekToNextMediaItem()
+    assertEquals(4, requests.size)
+    system.seekTo(7000)
+    assertEquals(Triple("chapter-3", "seek", 7.0), requests.last())
+    system.release()
+  }
+
+  @Test fun `remote pause stops native audio and play is routed through the chapter loader`() {
+    val requests = mutableListOf<String>()
+    val part = PartPlayer()
+    val system = LockScreenAudioPlayer(part) { _, action, _ -> requests.add(action) }
+    system.updatePlayback(chapter(playing = true))
+    system.pause()
+    assertFalse(part.playingRequested)
+    system.updatePlayback(chapter())
+    system.play()
+    assertFalse(part.playingRequested)
+    assertEquals(listOf("pause", "play"), requests)
+    system.updatePlayback(chapter(playing = false, buffering = true))
+    assertTrue(system.playWhenReady)
+    assertEquals(Player.STATE_BUFFERING, system.playbackState)
+    assertFalse(system.isPlaying)
+    system.pause()
+    assertEquals(listOf("pause", "play", "pause"), requests)
+    system.release()
+  }
+
+  @Test fun `cover metadata is supplied to MediaSession and clearing it removes the old artwork`() {
+    val system = LockScreenAudioPlayer(PartPlayer()) { _, _, _ -> }
+    system.updatePlayback(chapter())
+    system.updateMetadata(Metadata("第二章", "大众哲学", "JOJO", URL("https://example.com/cover.jpg")), byteArrayOf(1, 2, 3))
+    assertEquals("第二章", system.mediaMetadata.title)
+    assertEquals("大众哲学", system.mediaMetadata.artist)
+    assertArrayEquals(byteArrayOf(1, 2, 3), system.mediaMetadata.artworkData)
+    system.updateMetadata(Metadata("第三章", "另一书", null, null))
+    assertNull(system.mediaMetadata.artworkUri)
+    assertNull(system.mediaMetadata.artworkData)
+    system.release()
+  }
+
+  @Test fun `clearing virtual playback restores the original native API`() {
+    val requests = mutableListOf<String>()
+    val part = PartPlayer()
+    val system = LockScreenAudioPlayer(part) { _, action, _ -> requests.add(action) }
+    system.updatePlayback(chapter())
+    system.updatePlayback(null)
+    assertFalse(system.hasChapter)
+    assertEquals(89_000L, system.duration)
+    system.seekTo(12_000)
+    assertEquals(1, part.seekCalls)
+    assertTrue(requests.isEmpty())
+    system.release()
+  }
+}
