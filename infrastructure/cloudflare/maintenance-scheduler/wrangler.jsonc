{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jojokanbao-maintenance-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "MONITORS", "class_name": "MaintenanceMonitor" }]
  },
  "migrations": [{ "tag": "v1-monitor-state", "new_sqlite_classes": ["MaintenanceMonitor"] }],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "GITHUB_OWNER": "kargonerd",
    "GITHUB_REPO": "jojokanbao",
    "GITHUB_REF": "master"
  },
  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "HEALTHCHECKS_API_KEY"
    ]
  }
}
