{
  "installCommand": "npx --yes pnpm@9.12.2 install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/rag",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "${http.request.headers[\"Origin\"]}"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "authorization, content-type, makers-conversation-id"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/times",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "${http.request.headers[\"Origin\"]}"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "authorization, content-type, makers-conversation-id"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ],
  "cloudFunctions": {
    "maxDuration": 120
  },
  "agents": {
    "dir": "infrastructure/edgeone/agents/international",
    "timeout": 300
  }
}
