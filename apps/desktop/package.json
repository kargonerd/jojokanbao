{
  "name": "@jojo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "electron": "set PATH=%npm_node_execpath:node.exe=%;%PATH% && node ./dev-runner.mjs electron",
    "electron:dev": "set PATH=%npm_node_execpath:node.exe=%;%PATH% && node ./dev-runner.mjs electron",
    "app:dev": "set PATH=%npm_node_execpath:node.exe=%;%PATH% && node ./dev-runner.mjs app",
    "test:browser:bbox": "node ./test-proofread-pdfjs-alignment.mjs",
    "test:electron:bbox": "node ./test-proofread-electron-alignment.mjs",
    "verify:bbox": "pnpm test -- src/pages/ProofreadIssuesPage.test.tsx && pnpm run test:browser:bbox && pnpm run test:electron:bbox"
  },
  "dependencies": {
    "@jojo/editorial-preset": "workspace:*",
    "@jojo/pdf-viewer": "workspace:*",
    "@jojo/ui": "workspace:*",
    "dotenv": "^17.4.0",
    "pdfjs-dist": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@jojo/tsconfig": "workspace:*",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.1.0",
    "jsdom": "^26.0.0",
    "pdf2pic": "^3.2.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
