{
  "$defs": {
    "BlobReference": {
      "additionalProperties": false,
      "properties": {
        "byteCount": {
          "minimum": 0,
          "title": "Bytecount",
          "type": "integer"
        },
        "contentEncoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentencoding"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storedByteCount": {
          "minimum": 0,
          "title": "Storedbytecount",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "byteCount",
        "storedByteCount"
      ],
      "title": "BlobReference",
      "type": "object"
    },
    "CaptureCandidate": {
      "additionalProperties": false,
      "properties": {
        "byteCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytecount"
        },
        "capturedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capturedat"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "expectedHeadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedheadline"
        },
        "mimeType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mimetype"
        },
        "provider": {
          "$ref": "#/$defs/CaptureProvider"
        },
        "snapshotUrl": {
          "title": "Snapshoturl",
          "type": "string"
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceurl"
        },
        "statusCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuscode"
        },
        "warcFilename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warcfilename"
        },
        "warcLength": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warclength"
        },
        "warcOffset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warcoffset"
        }
      },
      "required": [
        "provider",
        "snapshotUrl"
      ],
      "title": "CaptureCandidate",
      "type": "object"
    },
    "CaptureProvider": {
      "enum": [
        "wayback",
        "arquivo-pt",
        "commoncrawl",
        "infini-news",
        "live-origin",
        "other"
      ],
      "title": "CaptureProvider",
      "type": "string"
    },
    "CaptureRepresentation": {
      "enum": [
        "raw-html",
        "derived-html"
      ],
      "title": "CaptureRepresentation",
      "type": "string"
    },
    "DependentResource": {
      "additionalProperties": false,
      "properties": {
        "blob": {
          "$ref": "#/$defs/BlobReference"
        },
        "contentType": {
          "title": "Contenttype",
          "type": "string"
        },
        "snapshotUrl": {
          "title": "Snapshoturl",
          "type": "string"
        },
        "sourceUrl": {
          "title": "Sourceurl",
          "type": "string"
        }
      },
      "required": [
        "sourceUrl",
        "snapshotUrl",
        "contentType",
        "blob"
      ],
      "title": "DependentResource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "articleId": {
      "title": "Articleid",
      "type": "string"
    },
    "candidatesConsidered": {
      "items": {
        "$ref": "#/$defs/CaptureCandidate"
      },
      "title": "Candidatesconsidered",
      "type": "array"
    },
    "canonicalUrl": {
      "title": "Canonicalurl",
      "type": "string"
    },
    "contentType": {
      "title": "Contenttype",
      "type": "string"
    },
    "dependentResources": {
      "items": {
        "$ref": "#/$defs/DependentResource"
      },
      "title": "Dependentresources",
      "type": "array"
    },
    "finalUrl": {
      "title": "Finalurl",
      "type": "string"
    },
    "formatVersion": {
      "default": "jojo-raw-capture/1",
      "title": "Formatversion",
      "type": "string"
    },
    "httpStatus": {
      "title": "Httpstatus",
      "type": "integer"
    },
    "publishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publishedat"
    },
    "publisher": {
      "title": "Publisher",
      "type": "string"
    },
    "qualityScore": {
      "title": "Qualityscore",
      "type": "integer"
    },
    "qualitySignals": {
      "title": "Qualitysignals",
      "type": "object"
    },
    "rawHtml": {
      "$ref": "#/$defs/BlobReference"
    },
    "representation": {
      "allOf": [
        {
          "$ref": "#/$defs/CaptureRepresentation"
        }
      ],
      "default": "raw-html"
    },
    "retrievedAt": {
      "format": "date-time",
      "title": "Retrievedat",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "selectedCandidate": {
      "$ref": "#/$defs/CaptureCandidate"
    }
  },
  "required": [
    "articleId",
    "publisher",
    "canonicalUrl",
    "selectedCandidate",
    "retrievedAt",
    "finalUrl",
    "httpStatus",
    "contentType",
    "qualityScore",
    "rawHtml"
  ],
  "title": "RawCapture",
  "type": "object"
}
