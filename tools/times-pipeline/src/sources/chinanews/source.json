  },
  "content": {
    "priority": [
      "discovery-body",
      "browser-parser",
      "discovery-summary"
    ],
    "parser": "chinanews",
    "minimumFullCharacters": 100,
    "minimumFullParagraphs": 1
  },
  "archive": {
