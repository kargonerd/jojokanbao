    },
    {
      "id": "finance",
      "name": "财经",
      "url": "https://www.zaobao.com.sg/finance",
      "kind": "topic"
    }
  ],
  "discovery": {
    "kind": "multi",
    "targets": [
      {
        "id": "latest-china",
        "sectionIds": [
          "latest",
          "china"
        ],
        "discovery": {
          "kind": "site-adapter",
          "adapter": "html-news-page",
          "url": "https://www.zaobao.com/realtime/china",
          "articlePathPrefixes": [
            "/realtime/",
            "/news/"
          ],
          "linkSelector": ".card-listing .card .content-header a[href], [data-testid='article-list'] article a.article-link[href]",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-singapore",
        "sectionIds": [
          "latest",
          "singapore"
        ],
        "discovery": {
          "kind": "site-adapter",
          "adapter": "html-news-page",
          "url": "https://www.zaobao.com/realtime/singapore",
          "articlePathPrefixes": [
            "/realtime/",
            "/news/"
          ],
          "linkSelector": ".card-listing .card .content-header a[href], [data-testid='article-list'] article a.article-link[href]",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-world",
        "sectionIds": [
          "latest",
          "world"
        ],
        "discovery": {
          "kind": "site-adapter",
          "adapter": "html-news-page",
          "url": "https://www.zaobao.com/realtime/world",
          "articlePathPrefixes": [
            "/realtime/",
            "/news/"
          ],
          "linkSelector": ".card-listing .card .content-header a[href], [data-testid='article-list'] article a.article-link[href]",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-finance",
        "sectionIds": [
          "latest",
          "finance"
        ],
        "discovery": {
          "kind": "site-adapter",
          "adapter": "html-news-page",
          "url": "https://www.zaobao.com/realtime/finance",
          "articlePathPrefixes": [
            "/realtime/",
            "/finance/"
          ],
          "linkSelector": ".card-listing .card .content-header a[href], [data-testid='article-list'] article a.article-link[href]",
          "maximumItems": 100
        }
      },
      {
        "id": "southeast-asia",
        "sectionIds": [
          "southeast-asia"
        ],
        "discovery": {
          "kind": "site-adapter",
          "adapter": "html-news-page",
          "url": "https://www.zaobao.com/news/sea",
          "articlePathPrefixes": [
            "/news/",
            "/realtime/"
          ],
          "linkSelector": ".card-listing .card .content-header a[href], [data-testid='article-list'] article a.article-link[href]",
          "maximumItems": 100
        }
      }
    ]
  },
  "content": {
    "priority": [
      "discovery-body",
      "browser-parser",
      "discovery-summary"
    ],
    "parser": "zaobao",
    "minimumFullCharacters": 200,
    "minimumFullParagraphs": 3
  },
  "archive": {
    "mode": "browser",
    "bpc": true,
    "proxyPolicy": "zaobao"
  },
  "health": {
    "minimumCandidates": 1
  },
  "enabled": true
}
