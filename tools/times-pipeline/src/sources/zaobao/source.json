        "discovery": {
          "kind": "source-adapter",
          "adapter": "zaobao",
          "driver": "http",
          "route": "latest-china",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-singapore",
        "sectionIds": [
          "latest",
          "singapore"
        ],
        "discovery": {
          "kind": "source-adapter",
          "adapter": "zaobao",
          "driver": "http",
          "route": "latest-singapore",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-world",
        "sectionIds": [
          "latest",
          "world"
        ],
        "discovery": {
          "kind": "source-adapter",
          "adapter": "zaobao",
          "driver": "http",
          "route": "latest-world",
          "maximumItems": 100
        }
      },
      {
        "id": "latest-finance",
        "sectionIds": [
          "latest",
          "finance"
        ],
        "discovery": {
          "kind": "source-adapter",
          "adapter": "zaobao",
          "driver": "http",
          "route": "latest-finance",
          "maximumItems": 100
        }
      },
      {
        "id": "southeast-asia",
        "sectionIds": [
          "southeast-asia"
        ],
        "discovery": {
          "kind": "source-adapter",
          "adapter": "zaobao",
          "driver": "http",
          "route": "southeast-asia",
          "maximumItems": 100
        }
      }
    ]
  },
  "content": {
    "priority": [
      "discovery-body",
      "captured-page",
      "discovery-summary"
    ],
    "parser": "zaobao",
    "minimumFullCharacters": 200,
    "minimumFullParagraphs": 3
  },
  "fetch": {
    "strategy": "browser-first",
    "bpc": true,
    "proxyPolicy": "rotate"
  },
  "health": {
    "minimumCandidates": 1
  },
  "enabled": true
}
