{
  "id": "zaobao",
  "name": "联合早报",
  "language": "zh-CN",
  "sections": [
    {
      "id": "latest",
      "name": "最新",
      "url": "https://www.zaobao.com.sg/realtime",
      "kind": "stream"
    },
    {
      "id": "singapore",
      "name": "新加坡",
      "url": "https://www.zaobao.com.sg/news/singapore",
      "kind": "region"
    },
    {
      "id": "world",
      "name": "国际",
      "url": "https://www.zaobao.com.sg/news/world",
      "kind": "region"
    },
    {
      "id": "china",
