{
  "id": "zaobao",
  "name": "联合早报",
  "language": "zh-CN",
  "publicationTimeZone": "Asia/Singapore",
  "sections": [
    {
      "id": "latest",
      "name": "最新",
      "url": "https://www.zaobao.com.sg/realtime"
    },
    {
