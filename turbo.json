{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"], "env": ["VITE_*", "EXPO_PUBLIC_*", "PUBLIC_POSTHOG_*", "PUBLIC_APP_VERSION", "PUBLIC_RELEASE_CHANNEL"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "verify:build": { "dependsOn": ["build"] },
    "lint": {}
  }
}
