# Monorepo-local configuration template.
# Copy shared values to .env. Use .env.local only for machine-specific
# overrides, and never commit real secrets.

# Local Supabase administration. These values are secret and must never be
# embedded into a browser build or committed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Shared browser auth configuration (public values embedded by Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Python Cloud API. The API reuses the public Supabase values above.
JOJO_ENV=development
JOJO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
JOJO_AUTH_TIMEOUT_SECONDS=5

# Staged rollout gates. Unfinished modules stay unreachable unless explicitly enabled.
VITE_ENABLE_PLATFORM_REDESIGN=false
VITE_ENABLE_ACCOUNT=false
VITE_ENABLE_RAG=false
VITE_ENABLE_TIMES=false

# Unified Web business APIs use same-origin /api/v1/* routes.
VITE_CONTENT_CDN_BASE=https://blacknews.jojokanbao.cn/
# Optional in local preview: merge a temporary local Jox build over the online catalog.
VITE_CONTENT_CDN_FALLBACK_BASE=

# Codex Agent. The deployed Agent runs in a separate non-mainland Makers project.
JOJO_AGENT_MODEL=gpt-5.6-luna
JOJO_AGENT_MAX_TURNS=8
JOJO_AGENT_MAX_TOOL_CALLS=20
JOJO_AGENT_SYSTEM_PROMPT=
JOJO_AGENT_ALLOWED_ORIGINS=https://jojokanbao.cn
JOJO_AGENT_UPSTREAM_URL=https://agent-global.jojokanbao.cn/jojo
JOJO_AGENT_SERVICE_SECRET=
JOJO_CREDENTIAL_SERVICE_URL=https://agent-global.jojokanbao.cn
JOJO_CREDENTIAL_ENCRYPTION_KEY=
# Existing local operator secret. Shared by Agent credential administration and
# the JOJO Console feature-flag proxy; never expose it through a VITE_* variable.
JOJO_OPERATOR_TOKEN=
