# Monorepo-local configuration template.
# Copy shared values to .env. Use .env.local only for machine-specific
# overrides, and never commit real secrets.

# Local Supabase administration. These values are secret and must never be
# embedded into a browser build or committed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Shared browser auth configuration (public values embedded by Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Python Cloud API. The API reuses the public Supabase values above.
JOJO_ENV=development
JOJO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
JOJO_AUTH_TIMEOUT_SECONDS=5
# Server-only access for the offline Times workflow and local pipeline runs.
JOJO_TIMES_RSSHUB_URL=https://jojokanbao-rsshub.onrender.com
JOJOKANBAO_RSSHUB_ACCESS_KEY=
# Server-only Google Gemini API key used by the offline Times translation stage.
GEMINI_API_KEY=
JOJO_TIMES_TRANSLATION_MODEL=gemma-4-31b-it
JOJO_TIMES_TRANSLATION_FALLBACK_MODEL=gemma-4-26b-a4b-it
JOJO_TIMES_TRANSLATION_WORKERS=8
JOJO_TIMES_TRANSLATION_REQUEST_TIMEOUT_MS=120000
JOJO_TIMES_TRANSLATION_BATCH_TIMEOUT_MS=480000
JOJO_TIMES_TRANSLATION_CHUNK_CHARACTERS=9000

# Production rollback gate. Local Vite development always uses the current platform.
VITE_ENABLE_PLATFORM_REDESIGN=false
# Times remains independently gated until it is ready to ship.
VITE_ENABLE_TIMES=false

# Reader uses same-origin /api/v1/* business routes and /gateway/ask for Agent requests.
VITE_CONTENT_CDN_BASE=https://blacknews.jojokanbao.cn/
# Optional separate Times CDN origin. Defaults to VITE_CONTENT_CDN_BASE.
VITE_TIMES_CDN_BASE=https://blacknews.jojokanbao.cn/
# Development only: allow the local Times audit page without a login session.
VITE_TIMES_AUDIT_PUBLIC=false
# Optional in local preview: merge a temporary local Jox build over the online catalog.
VITE_CONTENT_CDN_FALLBACK_BASE=

# Content publication. Hugging Face is the public Canonical source of truth;
# Backblaze B2 stores Delivery objects only. Authenticate HF with the CLI or HF_TOKEN.
HF_DATASET_REPO=luoxiaozhuang/marxism-dataset
HF_DATASET_PRIVATE=false
HF_TOKEN=
HF_XET_HIGH_PERFORMANCE=1
HF_UPLOAD_WORKERS=2
JOJO_DELIVERY_REMOTE=jojo-b2-s3:jojo-newspaper

# Codex Agent. The deployed Agent runs in a separate non-mainland Makers project.
JOJO_AGENT_MODEL=gpt-5.6-luna
JOJO_AGENT_MAX_TURNS=8
JOJO_AGENT_MAX_TOOL_CALLS=20
JOJO_AGENT_SYSTEM_PROMPT=
JOJO_AGENT_URL=https://agent-global.jojokanbao.cn/rag
JOJO_AGENT_DEV_PORT=8789
JOJO_CREDENTIAL_SERVICE_URL=https://agent-global.jojokanbao.cn
JOJO_CREDENTIAL_ENCRYPTION_KEY=
# Existing local operator secret. Shared by Agent credential administration and
# the JOJO Console feature-flag proxy; never expose it through a VITE_* variable.
JOJO_OPERATOR_TOKEN=
