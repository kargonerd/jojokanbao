{
  "name": "jojokanbao",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:agent": "pnpm --filter @jojo/agent dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "verify:build": "turbo verify:build",
    "lint": "turbo lint",
    "dev:desktop": "pnpm --filter @jojo/desktop dev:electron",
    "dev:backend": "python tools/dev-backend.py",
    "test:backend": "python -m pytest backend/tests -q",
    "prepare:web-deploy": "node infrastructure/edgeone/prepare-web-deploy.mjs",
    "prepare:agent-deploy": "node infrastructure/edgeone/prepare-agent-deploy.mjs",
    "push:credentials": "pnpm --filter @jojo/agent credentials:push",
    "dev:reader-search": "python tools/jojo-admin/server/content_search_app.py",
    "dev:admin-web": "pnpm --filter @jojo/admin dev",
    "build:admin": "pnpm --filter @jojo/admin build",
    "dev:admin-api": "cd tools/jojo-admin/server && python app.py",
    "dev:admin": "concurrently -k -n api,web -c red,blue \"pnpm dev:admin-api\" \"pnpm dev:admin-web\"",
    "dev:mobile": "pnpm --filter @jojo/mobile start",
    "dev:jiuwen-mobile": "pnpm dev:mobile",
    "dev:times-mobile": "pnpm dev:mobile",
    "finalize:archive-pdf": "node tools/archive-pdf/finalize.mjs",
    "protect:archive-pdf": "node tools/archive-pdf/protect.mjs",
    "publish:archive-pdf": "node tools/archive-pdf/publish.mjs",
    "purge:archive-pdf": "node tools/archive-pdf/purge-cache.mjs",
    "sync:rmrb": "python tools/archive-pdf/sync_rmrb.py",
    "verify:archive-pdf": "node tools/archive-pdf/verify.mjs",
    "invite:create": "node tools/manage-signup-invites.mjs create",
    "invite:list": "node tools/manage-signup-invites.mjs list",
    "invite:revoke": "node tools/manage-signup-invites.mjs revoke",
    "notices:generate": "node tools/licenses/generate-open-source-notices.mjs",
    "notices:check": "node tools/licenses/generate-open-source-notices.mjs --check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "concurrently": "^9.2.1",
    "turbo": "^2.4.0"
  },
  "pnpm": {
    "overrides": {
      "cheerio@1.2.0>undici": "8.10.0"
    },
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.83.10": "frontend/patches/@react-native__gradle-plugin@0.83.10.patch",
      "pdfjs-dist@5.7.284": "frontend/patches/pdfjs-dist@5.7.284.patch",
      "react-native-webview@13.16.0": "frontend/patches/react-native-webview@13.16.0.patch"
    }
  }
}
