{
  "name": "jojo-platform",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "verify:build": "turbo verify:build",
    "lint": "turbo lint",
    "dev:rag-backend": "cd services/rag-backend && python run_simple.py",
    "dev:desktop": "pnpm --filter @jojo/desktop app:dev",
    "dev:press-engine": "cd services/press-engine && python -m uvicorn jojo_press.app:app --host 127.0.0.1 --port 8765 --reload",
    "dev:reader-search": "cd services/reader-search && python app.py",
    "dev:data-workbench": "pnpm --filter @jojo/data-workbench dev",
    "build:data-workbench": "pnpm --filter @jojo/data-workbench build",
    "dev:jojo-pipe-api": "cd internal/data-workbench/server && python app.py",
    "dev:jojo-pipe": "concurrently -k -n api,web -c red,blue \"pnpm dev:jojo-pipe-api\" \"pnpm dev:data-workbench\"",
    "dev:jiuwen-api": "python services/jiuwen-api/run.py",
    "dev:jiuwen-mobile": "pnpm --filter @jojo/jiuwen-mobile start",
    "finalize:reader-pdf": "node tooling/reader-pdf/finalize.mjs",
    "protect:reader-pdf": "node tooling/reader-pdf/protect.mjs",
    "publish:reader-pdf": "node tooling/reader-pdf/publish.mjs",
    "purge:reader-pdf": "node tooling/reader-pdf/purge-cache.mjs",
    "sync:rmrb": "python tooling/reader-pdf/sync_rmrb.py",
    "verify:reader-pdf": "node tooling/reader-pdf/verify.mjs",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "concurrently": "^9.2.1",
    "turbo": "^2.4.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "pdfjs-dist@5.7.284": "patches/pdfjs-dist@5.7.284.patch"
    }
  }
}
